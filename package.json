{
  "name": "easy-fashion-dashboard",
  "version": "1.1.0",
  "description": "Easy Fashion Ltd. Admin Dashboard built with Next.js and Ant Design",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --dangerouslyIgnoreUnhandledErrors --reporter=default --reporter=json --outputFile.json=coverage/test-results.json && node scripts/write-badges.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "next": "^15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
